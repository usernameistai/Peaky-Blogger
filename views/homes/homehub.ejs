<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/homehub.css">

		<header>
			<div class="container rounded mx-auto p-5 pageone pb-shadow">
				<h2 class="ms-0 me-0 mt-1 pb-0 pb-col">
						<div class="row">
								<div><i class="fas fa-tree fa-2x"></i><i class="fas fa-utensils fa-2x"></i></div>
								<div class="txt-shad bold">Peaky Blogger's guide to Food and Adventure</div>
						</div>
				</h2>
				<p class="pb-col text-center pb-3 bold">Look no further than the <strong>Homehub</strong>, for all your walking and eating needs</p>
			</div>
		</header>
		<main class="mt-5">
			<section class="top-container text-white">
				<header class="showcase pb-inset-shadow p-5">
					<h1>Pubs and Restaurants in the Peak District<h1>
					<p>My Blogs and Experiences</p>
					<a href="/walks" class="btn btn-info text-white">Look here.. <i class="fa-solid fa-person-hiking"></i> <i class="fa-solid fa-caret-right"></i></a>
				</header>
				<aside class="top-box top-box-a pb-inset-shadow text-center">
					<p class="hh4">Favourite areas of the Peak District</p>
					<!-- <p class="price">Places / Walks</p> -->
					<a href="/walks-map" class="btn btn-info text-white">More info.. <i class="fa-solid fa-map-location-dot"></i> <i class="fa-solid fa-caret-right"></i></a>
				</aside>
				<aside class="top-box top-box-b pb-inset-shadow text-center">
					<p class="hh3">Photo Gallery</p>
					<p class="price"></p>
					<a href="/gallery" class="btn btn-info text-white">Look here.. <i class="fa-solid fa-images"></i> <i class="fa-solid fa-caret-right"></i></a>
				</aside>
				<div class="showmap">
					<div id="map" class="rounded mb-3 pb-shadow mapstyleh" ></div>
				</div>
			</section><br>
            <!-- boxes section-->
			<section class="boxes">
				<div class="box">
					<i class="fas fa-tint fa-3x"></i> <i class="fa-solid fa-tree fa-3x"></i> <i class="fa-solid fa-person-hiking fa-3x"></i> <i class="fa-solid fa-utensils fa-3x"></i> <i class="far fa-sun fa-3x"></i>
					<p class="hh4">About</p>
					<p class="hh6">Brief self-synopsis and aim of the site</p>
					<a href="/about" class="btn btn-lg onh pb-col"><i class="fa-regular fa-address-card fa-2x"></i> <i class="fa-solid fa-book-journal-whills fa-2x"></i></a>
				</div>
				<div class="box">
					<i class="fa-solid fa-tree fa-3x"></i> <i class="fa-brands fa-skyatlas fa-3x"></i>  <i class="fa-solid fa-tree-city fa-3x"></i> 
					<p class="hh4">Peak District</p>
					<p class="hh6">Some events in the Peak District calendar here</p>
					<a href="https://visitpeakdistrict.com/events" class="btn btn-lg onh pb-col"><i class="fa-regular fa-calendar fa-2x"></i></a>
				</div>
				<div class="box">
					<i class="fab fa-youtube fa-3x"></i>
					<p class="hh4">V-log YouTube</p>
					<p class="hh6">Some of my v-logs from my walks</p>
					<a href="https://www.youtube.com/user/DavidBattye" class="btn btn-lg onh pb-col"><i class="fab fa-square-youtube fa-2x"></i></a>
				</div>
				<div class="box">
					<i class="fa-solid fa-envelope fa-3x"></i>
					<p class="hh4">Contact Me</p>
					<p class="hh6">Click here to send me a message via email or socials</p>
					<a href="/contact" class="btn btn-lg onh pb-col"><i class="fa-regular fa-envelope fa-2x"></i></a>
				</div>
			</section><br>

			<section class="info rounded pb-inset-shadow ">
				<img src="images/studland_building_pb_villa.webp" class="img-fluid rounded" loading="lazy"/>
				<p class="h2 mt-0 align-items-top txt-lshad">Top restaurants and places to eat in the Peak District</p><br>
					<a class="text-center text-decoration-none pb-col loh txt-lshad" href="https://www.tripadvisor.co.uk/Restaurants-g2360580-Peak_District_England.html">
							<i class="fa-solid fa-person-hiking fa-2x"></i> <i class="fa-solid fa-mountain fa-2x"></i> <i class="fa-solid fa-tree fa-2x"></i> <i class="fa-solid fa-utensils fa-2x"></i>
					</a>
				<p class="pb-col txt-shad bold">Some of these places I've visited, others I haven't, <a class="tdn" href="/walks-map">see here <i class="fa-solid fa-map-location-dot fa-2x pb-col"></i></a></p>
				<a href="https://www.tripadvisor.co.uk/Restaurants-g2360580-Peak_District_England.html" class="btn btn-lg btn-outline-info my-auto woodlandgreen text-white">More Info - Trip Advisor</a>
			</section><br>


			
			<section class="homhbott my-5">
				<div class="d-flex gap-2 mb-5">
					<div class="card p-3 pb-shadow col pb-inset-shadow ">
						<img class="card-img-top rounded mb-5 img-fluid" src="images/pdnpa-map.webp" loading="lazy" >
						<div class="card-body p-2">
							<h6 class="card-title">Peak District Map (linked below) </h6>
							<a href="https://www.peakdistrict.gov.uk/visiting/planning-your-visit/maps/pdmap" class="btn btn-outline-info woodlandgreen woodlandgreen-inset pb-shadow text-white px-2 py-1">P-D National Park</a>
						</div>
					</div>
					<div class="card p-3 pb-shadow col pb-inset-shadow ">
						<img class="card-img-top rounded mb-2 img-fluid" src="images/english_combine_harvester.webp" loading="lazy">
						<div class="card-body p-2">
							<h6 class="card-title">Or just want a lazy pub day?</h6>
							<a href="https://great-british-pubs.co.uk/inspire/beer-garden/" class="btn btn-outline-info woodlandgreen woodlandgreen-inset pb-shadow text-white px-2 py-1">Lazy Days</a>
						</div>
					</div>
				</div>
			</section>
    </main>

		<script>
			const mapToken = `<%- process.env.MAPBOX_TOKEN %>`; 
			const walks =  {features: <%- JSON.stringify(walks) %>};
		</script>
		<script src="/javascripts/clusterMap.js" defer></script>
