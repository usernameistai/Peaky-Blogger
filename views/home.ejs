<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peaky Blogger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://kit.fontawesome.com/1b4cd16f62.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/stylesheets/home.css">

</head>
<body class="d-grid text-center text-white">
    <div class="container-lg d-grid w-100 h-100 p-3 mx-auto flex-column">
        <header class="mb-auto">
            <div>
                <h3 class="float-md-start mb-1 pb-col bold"><i class="fa-solid fa-tree"></i><i class="fa-solid fa-utensils"></i> <sub >Peaky Blogger</sub></h3>
                <nav class="nav nav-masthead my-auto justify-content-center float-md-end">
                    <a href="/" class="nav-link active pb-col" aria-current="page">Home</a>
                    <a href="/homehub" class="nav-link">HomeHub</a>
                    <a href="/walks" class="nav-link">Walks</a>
                    <% if(!currentUser) { %>
                        <a class="nav-link" href="/login">Login</a>
                        <a class="nav-link" href="/signup">Sign Up</a>
                    <% } else { %>
                        <h4 class="my-auto ms-3 mb-2">Welcome <%=currentUser.username %></h4>
                        <a class="nav-link" href="/logout">Logout</a>
                    <% } %>
                </nav>
            </div>
        </header>
        <main class="">
            <section class="home rounded p-3 text-center my-5 pb-shadow"> 
                <h1 class="bold lin-grad mt-3 mt-md-4 fs-1 flex-wrap justify-content-center align-items-baseline gap-2">
                    <span class="d-inline-block">
                        <i class="fa-solid fa-tree fa-2x"></i><i class="fa-solid fa-utensils fa-2x"></i>
                    </span>
                    <sub class="fs-1 font-weight-bold">Peaky Blogger's</sub>
                </h1>
                
                <h1 class="text-white bold my-4 my-md-5 fs-4">Where to Walk & Eat in the Peak District</h1>
                
                <div class="mb-4 pt-2">
                    <a href="/homehub" class="btn btn-lg pb-col text-white thisway shadowy">THIS WAY</a>
                </div>
            </section>

            <section>
                <div class="container">
                    <div class="btn-group shadowy logsig" role="group">
                        <button class="btn btn-info shadowy"><a class="btn btn-info bgt" href="/login">LOGIN</a></button>
                        <button class="btn btn-info shadowy"><a class="btn btn-info bgt" href="/signup">SIGNUP</a></button>
                    </div>
                </div>
            </section>
        </main>
        <footer class="mt-auto">
            <p class="bold fs-6 text-white" >
                &copy; 2025 Peaky Blogger
                <a class="notd" href="/">Home</a> | 
                <a class="notd" href="/about">About</a> | 
                <a class="notd" href="#">Favourite Eating Spots</a> | 
                <a class="notd" href="#">Favourite Walks</a> |
                <a class="notd" href="https://www.youtube.com/user/DavidBattye">Vlogs</a> |
                <a class="notd" href="/contact">Contact Me</a>
            </p>
        </footer>
    </div>
    

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
</body>
</html>