<% layout('layouts/boilerplate') %>

<h2>Search Results for "<%= query %>"</h2>

<% if (walks.length === 0) { %>
  <p>No walks found matching your terms</p>
<% } else { %>
  <ul>
    <% walks.forEach(walk => { %>
      <li><a href=`/walks/<%= walk._id %>`><%= walk.title %></a></li>
    <% }) %>
  </ul>